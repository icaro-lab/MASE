# =============================================================================
# MASE (Multi-Agent Simulation Environment) - Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# General Configuration
# =============================================================================

# Application environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Node environment for frontend
NODE_ENV=development

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL settings
POSTGRES_USER=mase
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=mase
ADMIN_DATABASE_URL=postgresql://mase:change_this_in_production@postgres:5432/mase_admin
CONTROLLER_DATABASE_URL=postgresql://mase:change_this_in_production@postgres:5432/mase_runs

# =============================================================================
# Redis Configuration
# =============================================================================

# Redis connection URL
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Security Configuration
# =============================================================================

# JWT secret for authentication (change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# API key for service-to-service communication
INTERNAL_API_KEY=internal-api-key-change-this

# TLS/SSL settings
ENABLE_TLS=false
TLS_CERT_PATH=/app/certs/cert.pem
TLS_KEY_PATH=/app/certs/key.pem

# =============================================================================
# Service URLs
# =============================================================================

# Internal service URLs (for Docker networking)
ADMIN_BACKEND_URL=http://admin-backend:8001
CONTROLLER_URL=http://controller:8002
AGENT_LAUNCHER_URL=http://agent-launcher:8004

# Host port mappings for docker compose
# For parallel worktrees on one Docker daemon, use unique values per worktree.
COMPOSE_PROJECT_NAME=mase
HOST_PROJECT_ROOT=.
ADMIN_FRONTEND_PORT=3016
ADMIN_BACKEND_PORT=8001
CONTROLLER_PORT=8002
AGENT_LAUNCHER_PORT=8004
ORCHESTRATOR_PORT=8006
POSTGRES_PORT=5433
REDIS_PORT=6380
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# Core network name shared by core services + per-run stacks.
# Set a unique value per worktree when running multiple stacks in parallel.
MASE_NETWORK_NAME=mase-network

# Runtime image used by per-run stacks.
# Environment images are derived from each environment manifest's `launch.images.*`
# entries and built as `<repository>:<COMPOSE_PROJECT_NAME>`.
AGENT_WORKER_IMAGE=mase-agent-launcher:latest

# =============================================================================
# Run Limits
# =============================================================================

# Maximum concurrent runs
MAX_CONCURRENT_RUNS=5

# Maximum agents per run
MAX_AGENTS_PER_RUN=100

# Default run timeout in seconds
RUN_TIMEOUT_SECONDS=3600

# Agent resource limits
AGENT_DEFAULT_MEMORY_LIMIT=512m
AGENT_DEFAULT_CPU_LIMIT=1.0

# =============================================================================
# Agent Launcher Configuration
# =============================================================================

# Docker socket path (usually /var/run/docker.sock)
DOCKER_SOCKET=/var/run/docker.sock

# LLM Provider: openrouter, openai, anthropic
AGENT_LAUNCHER_LLM_PROVIDER=openrouter
AGENT_LAUNCHER_LLM_MODEL=anthropic/claude-3.5-sonnet

# Canonical OpenRouter API key used by both controller and agent launcher unless
# a more specific override is set below.
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter API Configuration (required when using openrouter provider)
# Get your API key from: https://openrouter.ai/keys
AGENT_LAUNCHER_OPENROUTER_API_KEY=

# Admin general OpenRouter key for new runs. Used when a run does not specify an api_key
# in admin dashboard creation.
ADMIN_OPENROUTER_API_KEY_FALLBACK=

# Optional override file path for admin-configured general keys from Config UI.
ADMIN_OPENROUTER_API_KEY_FILE=/data/admin-openrouter-settings.json

# OpenRouter optional headers for site/app identification (used for rankings)
AGENT_LAUNCHER_OPENROUTER_HTTP_REFERER=
AGENT_LAUNCHER_OPENROUTER_X_TITLE=

# Optional controller-level override (applies to run launch when api_key is not passed)
# Leave unset to inherit OPENROUTER_API_KEY.
SIM_CTRL_OPENROUTER_API_KEY=

# Agent network name
AGENT_NETWORK=mase-agent-network

# Agent spawn rate limiting
AGENT_SPAWN_RATE_PER_SECOND=5

# =============================================================================
# Monitoring Configuration
# =============================================================================

# Enable Prometheus metrics
ENABLE_PROMETHEUS=true

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =============================================================================
# External Services (Optional)
# =============================================================================

# External metrics storage
# DATADOG_API_KEY=
# NEW_RELIC_LICENSE_KEY=

# Cloud storage for run artifacts
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable real-time dashboard
FEATURE_REALTIME_DASHBOARD=true

# Enable advanced metrics collection
FEATURE_ADVANCED_METRICS=true

# Enable run replay functionality
FEATURE_RUN_REPLAY=true

# Enable custom agent image building
FEATURE_CUSTOM_AGENT_IMAGES=true

# =============================================================================
# Development Settings
# =============================================================================

# Enable hot reload for development
HOT_RELOAD=true

# Enable debug endpoints (disable in production)
DEBUG_ENDPOINTS=true

# Mock external services for testing
MOCK_SERVICES=false

# =============================================================================
# Email/Notification Settings (Optional)
# =============================================================================

# SMTP settings for alerts
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@mase.local

# Slack webhook for alerts
# SLACK_WEBHOOK_URL=

# =============================================================================
# Backup and Recovery
# =============================================================================

# Backup schedule (cron expression)
BACKUP_SCHEDULE=0 2 * * *

# Backup retention in days
BACKUP_RETENTION_DAYS=30

# =============================================================================
# Performance Tuning
# =============================================================================

# Worker processes per service
WORKER_PROCESSES=4

# Database connection pool size
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Async worker threads
ASYNC_WORKERS=8
