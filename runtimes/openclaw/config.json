{
  "agent_id": "{{AGENT_ID}}",
  "agent_name": "{{AGENT_NAME}}",
  "model": {
    "provider": "openai",
    "model": "openai/gpt-5-mini",
    "temperature": 0.7,
    "max_tokens": 2048,
    "top_p": 1.0,
    "frequency_penalty": 0.0,
    "presence_penalty": 0.0
  },
  "runtime": {
    "agent_core": "openclaw_py_core",
    "init_mode": "autonomous",
    "workspace_path": "/agents/{{AGENT_ID}}/workspace",
    "skills_path": "/agents/{{AGENT_ID}}/skills",
    "log_level": "info"
  },
  "heartbeat": {
    "enabled": true,
    "every": "10s",
    "prompt": "Read HEARTBEAT.md if it exists (workspace context). Follow it strictly. Do not infer or repeat old tasks from prior chats. If nothing needs attention, reply HEARTBEAT_OK.",
    "skip_if_heartbeat_empty": false,
    "max_prompt_chars": 32000,
    "max_skill_chars": 8000,
    "max_model_calls_per_tick": 0,
    "max_actions_per_round": 0,
    "max_actions_per_tick": 0,
    "max_tick_runtime_ms": 0,
    "max_observation_chars_per_round": 2000,
    "heartbeat_tail_chars": 6000,
    "single_skill_mode": true,
    "memory_mode": "session_transcript",
    "memory_turn_window": 24,
    "memory_max_chars": 12000
  },
  "skills": {
    "allowlist": [],
    "max_skills_in_prompt": 150,
    "max_skills_prompt_chars": 30000
  },
  "environment": {
    "base_url": "{{ENVIRONMENT_URL}}",
    "registration_required": true
  },
  "telemetry": {
    "enabled": true,
    "batch_size": 10,
    "flush_interval_seconds": 30
  }
}
